{% extends 'admin.twig' %}

{% set title %}{{ siteName }} - Alerts{% endset %}
{% block pageTitle %}{{ siteName }} - Alerts - selfwatch{% endblock %}
{% block pageDescription %}selfwatch alert rules for {{ siteName|escape("html_attr") }}{% endblock %}

{% block content %}
<style>
    .sw-alerts { margin:8px 0 40px; max-width:1000px; }
    .sw-alerts h2 { margin:6px 0 2px; }
    .sw-alerts__sub { color:#667085; font-size:13px; margin-bottom:18px; }
    .sw-card { border:1px solid #e4e7ec; border-radius:10px; background:#fff; padding:16px 18px; margin-bottom:18px; }
    .sw-card h3 { margin:0 0 12px; font-size:15px; }
    .sw-form-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12px 16px; }
    .sw-field label { display:block; font-size:12px; color:#475467; margin-bottom:4px; font-weight:600; }
    .sw-field input[type=text], .sw-field input[type=number], .sw-field select {
        width:100%; height:34px; border:1px solid #d0d5dd; border-radius:6px; padding:0 10px; font-size:13px; box-sizing:border-box; }
    .sw-field--full { grid-column:1 / -1; }
    .sw-form-actions { margin-top:14px; display:flex; gap:10px; align-items:center; }
    .sw-btn { height:34px; border:1px solid #d0d5dd; border-radius:6px; background:#fff; color:#344054; font-size:13px; padding:0 14px; cursor:pointer; text-decoration:none; display:inline-flex; align-items:center; }
    .sw-btn:hover { background:#f9fafb; }
    .sw-btn--primary { background:#3450A3; border-color:#3450A3; color:#fff; }
    .sw-btn--primary:hover { background:#2b4490; }
    .sw-btn--danger { border-color:#fda29b; color:#b42318; }
    .sw-btn--sm { height:28px; padding:0 10px; font-size:12px; }
    .sw-table { width:100%; border-collapse:collapse; font-size:13px; }
    .sw-table th { text-align:left; color:#667085; font-weight:600; border-bottom:1px solid #e4e7ec; padding:7px 10px; }
    .sw-table td { padding:8px 10px; border-bottom:1px solid #f2f4f7; vertical-align:middle; }
    .sw-badge { display:inline-block; padding:1px 9px; border-radius:10px; font-size:11px; font-weight:600; }
    .sw-on { background:#ecfdf3; color:#067647; } .sw-off { background:#f2f4f7; color:#667085; }
    .sw-sent { background:#ecfdf3; color:#067647; } .sw-failed { background:#fef3f2; color:#b42318; }
    .sw-cond { color:#475467; font-family:ui-monospace,Menlo,Consolas,monospace; font-size:12px; }
    .sw-muted { color:#98a2b3; }
    .sw-inline { display:inline; margin:0; }
</style>

<div class="sw-alerts">
    <h2>{{ siteName }} &middot; Alerts</h2>
    <div class="sw-alerts__sub">Fire a webhook or email when incoming logs match a rule. Evaluated on every ingest, throttled per rule.</div>

    {# ---- Add / edit form ---- #}
    {% set e = editRule %}
    <div class="sw-card">
        <h3>{{ e ? 'Edit rule' : 'New alert rule' }}</h3>
        <form method="post" action="index.php">
            <input type="hidden" name="module" value="Logs"><input type="hidden" name="action" value="saveAlert">
            <input type="hidden" name="idSite" value="{{ idSite }}"><input type="hidden" name="period" value="{{ period }}"><input type="hidden" name="date" value="{{ date }}">
            <input type="hidden" name="nonce" value="{{ nonce }}">
            <input type="hidden" name="idalertrule" value="{{ e.idalertrule|default(0) }}">

            <div class="sw-form-grid">
                <div class="sw-field sw-field--full">
                    <label>Rule name</label>
                    <input type="text" name="name" value="{{ e.name|default('') }}" placeholder="e.g. Errors on payments" required>
                </div>
                <div class="sw-field">
                    <label>Fire when level is at least</label>
                    <select name="min_level">
                        {% for lv in levels %}<option value="{{ lv }}" {{ (e.min_level|default('error')) == lv ? 'selected' }}>{{ lv }}</option>{% endfor %}
                    </select>
                </div>
                <div class="sw-field">
                    <label>Source matches (optional)</label>
                    <input type="text" name="source" value="{{ e.source|default('') }}" placeholder="any source">
                </div>
                <div class="sw-field sw-field--full">
                    <label>Message contains (optional)</label>
                    <input type="text" name="message_contains" value="{{ e.message_contains|default('') }}" placeholder="substring to match in the message">
                </div>
                <div class="sw-field">
                    <label>Channel</label>
                    <select name="channel">
                        {% for c in channels %}<option value="{{ c }}" {{ (e.channel|default('webhook')) == c ? 'selected' }}>{{ c }}</option>{% endfor %}
                    </select>
                </div>
                <div class="sw-field">
                    <label>Target (webhook URL or email)</label>
                    <input type="text" name="channel_target" value="{{ e.channel_target|default('') }}" placeholder="https://hooks… or you@example.com" required>
                </div>
                <div class="sw-field">
                    <label>Cooldown (seconds)</label>
                    <input type="number" name="cooldown_seconds" min="0" value="{{ e.cooldown_seconds|default(60) }}">
                </div>
                <div class="sw-field" style="align-self:end;">
                    <label><input type="checkbox" name="enabled" value="1" {{ (e is null or e.enabled) ? 'checked' }}> Enabled</label>
                </div>
            </div>

            <div class="sw-form-actions">
                <button type="submit" class="sw-btn sw-btn--primary">{{ e ? 'Save changes' : 'Create rule' }}</button>
                {% if e %}<a class="sw-btn" href="index.php?module=Logs&action=alerts&idSite={{ idSite }}&period={{ period }}&date={{ date }}">Cancel</a>{% endif %}
            </div>
        </form>
    </div>

    {# ---- Rules list ---- #}
    <div class="sw-card">
        <h3>Rules</h3>
        <table class="sw-table">
            <thead><tr><th>Name</th><th>Condition</th><th>Notify</th><th>Cooldown</th><th>Status</th><th></th></tr></thead>
            <tbody>
            {% for r in rules %}
                <tr>
                    <td><strong>{{ r.name }}</strong></td>
                    <td class="sw-cond">level&ge;{{ r.min_level }}{% if r.source %} &middot; src={{ r.source }}{% endif %}{% if r.message_contains %} &middot; ~"{{ r.message_contains }}"{% endif %}</td>
                    <td>{{ r.channel }} &rarr; <span class="sw-muted">{{ r.channel_target }}</span></td>
                    <td>{{ r.cooldown_seconds }}s</td>
                    <td><span class="sw-badge {{ r.enabled ? 'sw-on' : 'sw-off' }}">{{ r.enabled ? 'enabled' : 'disabled' }}</span></td>
                    <td style="white-space:nowrap;text-align:right;">
                        <a class="sw-btn sw-btn--sm" href="index.php?module=Logs&action=alerts&idSite={{ idSite }}&period={{ period }}&date={{ date }}&edit={{ r.idalertrule }}">Edit</a>
                        {% for act, label in {'toggleAlert': (r.enabled ? 'Disable' : 'Enable'), 'deleteAlert': 'Delete'} %}
                        <form class="sw-inline" method="post" action="index.php" {% if act == 'deleteAlert' %}onsubmit="return confirm('Delete this rule?');"{% endif %}>
                            <input type="hidden" name="module" value="Logs"><input type="hidden" name="action" value="{{ act }}">
                            <input type="hidden" name="idSite" value="{{ idSite }}"><input type="hidden" name="period" value="{{ period }}"><input type="hidden" name="date" value="{{ date }}">
                            <input type="hidden" name="nonce" value="{{ nonce }}"><input type="hidden" name="idalertrule" value="{{ r.idalertrule }}">
                            <button type="submit" class="sw-btn sw-btn--sm {{ act == 'deleteAlert' ? 'sw-btn--danger' }}">{{ label }}</button>
                        </form>
                        {% endfor %}
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="6" class="sw-muted" style="padding:18px;text-align:center;">No alert rules yet. Create one above.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    {# ---- Recent fired alerts ---- #}
    <div class="sw-card">
        <h3>Recent alerts</h3>
        <table class="sw-table">
            <thead><tr><th>Time</th><th>Rule</th><th>Level</th><th>Message</th><th>Channel</th><th>Result</th></tr></thead>
            <tbody>
            {% for ev in events %}
                <tr>
                    <td class="sw-muted" style="white-space:nowrap;">{{ ev.fired_at }}</td>
                    <td>{{ ev.rule_name|default('—') }}</td>
                    <td>{{ ev.level }}</td>
                    <td>{{ ev.message }}</td>
                    <td>{{ ev.channel }}</td>
                    <td>
                        <span class="sw-badge {{ ev.status == 'sent' ? 'sw-sent' : 'sw-failed' }}">{{ ev.status }}</span>
                        {% if ev.error %}<span class="sw-muted" title="{{ ev.error }}"> ⚠</span>{% endif %}
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="6" class="sw-muted" style="padding:18px;text-align:center;">No alerts have fired yet.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
